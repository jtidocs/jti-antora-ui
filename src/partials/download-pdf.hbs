{{#if (pdfLink)}}
<div class="navbar-item hide-for-print">
  <span class="control">
    <a class="button is-primary" href="{{{siteRootPath}}}/{{{pdfLink}}}">Download PDF</a>
  </span>
</div>
{{/if}}
{{#with (resolvePage page.relativeSrcPath model=false)}}
  {{#with ./assembler.pdf}}
    <div class="navbar-item hide-for-print">
      <span class="control">
        <a class="button is-primary" href="{{{relativize ./file.pub.url}}}">Download PDF</a>
      </span>
    </div>
  {{/with}}
{{/with}}
